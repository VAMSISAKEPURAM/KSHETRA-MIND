# KshetraMind AI Backend Environment Variables
# Configure external LLM and Voice AI providers here.

# --- Groq Cloud LLM Reasoning Configuration ---
# Get your free/ultra-fast API key at https://console.groq.com/keys
GROQ_API_KEY=
# Supported models: llama-3.3-70b-versatile, deepseek-r1-distill-llama-70b, llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional External Voice AI Providers ---
# SARVAM_API_KEY=your_sarvam_api_key_here
